    <string name="about_title">About</string>
    <string name="about_subtitle">HouseStudy · Eight Mansions Feng Shui</string>
    <string name="about_intro_title">Introduction</string>
    <string name="about_intro">Based on Eight Mansions Feng Shui (East and West Four Life groups), plan family members and rooms across the nine palaces, and derive your life Gua with auspicious and inauspicious directions from your birth year.</string>
    <string name="about_features_title">Features</string>
    <string name="feat_layout">Layout: place members or rooms on the nine palaces and read per-palace interpretations.</string>
    <string name="feat_destiny">Destiny: derive your life Gua and the four auspicious / inauspicious directions from birth year and gender.</string>
    <string name="feat_save">Archive: save multiple plans and reload them anytime for comparison.</string>
    <string name="about_note_title">Note</string>
    <string name="about_note">Feng shui is traditional folk culture. This app is for learning and reference only and does not constitute any decision advice.</string>

