    <string name="about_title">关于</string>
    <string name="about_subtitle">HouseStudy · 八宅风水</string>
    <string name="about_intro_title">应用简介</string>
    <string name="about_intro">以八宅风水（东西四命）为基础，帮助你在九宫格中规划家庭成员与房间的方位布局，并依据出生年份推算个人命卦与吉凶方位。</string>
    <string name="about_features_title">功能</string>
    <string name="feat_layout">布局：在九宫格中放置成员或房间，逐宫查看方位解读。</string>
    <string name="feat_destiny">命理：按出生年份与性别推算命卦、四吉四凶方位。</string>
    <string name="feat_save">存档：保存多套方案，随时读取对比。</string>
    <string name="about_note_title">说明</string>
    <string name="about_note">风水属传统民俗文化，本应用仅供学习与参考，不构成任何决策建议。</string>

